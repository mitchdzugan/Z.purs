import Z.XDom.Prelude

defIcon :: forall dx x. String -> MDomEl dx x Unit -> MDom dx x Unit
defIcon d el'svg = do
  dom'svg do
    el'cn "size-6"
    el'svg
    el'xmlns "http://www.w3.org/2000/svg"
    el'viewBox "0 0 640 640"
    el'setM $ dom'path do
      el'fill "currentColor"
      el'd d

